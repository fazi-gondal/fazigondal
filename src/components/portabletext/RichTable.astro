---
/**
 * RichTable.astro — Portable Text renderer for sanity-plugin-rich-table blocks.
 *
 * Data shape (from GROQ / Sanity):
 *   {
 *     _type: 'richTableBlock',
 *     hasColumnTitles?: boolean,
 *     hasRowTitles?: boolean,
 *     columnHeaders?: Array<{ title?: string, cellIndex: number, width?: number }>,
 *     rows?: Array<{
 *       _key: string,
 *       title?: string,
 *       cells?: Array<{ _key: string, content?: PortableTextBlock[] }>
 *     }>
 *   }
 */
import { PortableText } from 'astro-portabletext';
import type { TypedObjectProps } from 'astro-portabletext/types';

interface Cell {
  _key: string;
  content?: unknown[];
}

interface Row {
  _key: string;
  title?: string;
  cells?: Cell[];
}

interface ColHeader {
  title?: string;
  cellIndex: number;
  width?: number;
}

// astro-portabletext v1 passes the block as `node` (not `value`).
type Props = TypedObjectProps;

const { node } = Astro.props;
const { rows = [], columnHeaders = [], hasColumnTitles, hasRowTitles } = node as unknown as {
  hasColumnTitles?: boolean;
  hasRowTitles?: boolean;
  columnHeaders?: ColHeader[];
  rows?: Row[];
};

// Number of data columns = max cells in any row
const colCount = rows.reduce((max, r) => Math.max(max, r.cells?.length ?? 0), 0);
---

<div class="portable-table-wrap">
  <table class="portable-table">
    {hasColumnTitles && columnHeaders.length > 0 && (
      <thead>
        <tr>
          {hasRowTitles && <th class="row-header-corner"></th>}
          {Array.from({ length: colCount }, (_, i) => {
            const col = columnHeaders.find(h => h.cellIndex === i);
            return <th style={col?.width ? `width:${col.width}px` : ''}>{col?.title ?? ''}</th>;
          })}
        </tr>
      </thead>
    )}
    <tbody>
      {rows.map((row) => (
        <tr>
          {hasRowTitles && <th class="row-header">{row.title ?? ''}</th>}
          {(row.cells ?? []).map((cell) => (
            <td>
              {cell.content && cell.content.length > 0
                ? <PortableText value={cell.content as any} />
                : null}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>


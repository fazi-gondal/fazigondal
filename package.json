{
  "name": "engineering-notebook-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && npm run security:check-client",
    "preview": "astro preview",
    "security:check-client": "node scripts/check-client-secrets.mjs",
    "check": "astro check",
    "studio": "sanity dev --host 0.0.0.0",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "sanity:migrate-journal": "tsx scripts/migrate-markdown-body.ts",
    "sanity:migrate-journal:dry": "tsx scripts/migrate-markdown-body.ts --dry-run",
    "sanity:sync-assets": "tsx scripts/sync-sanity-assets.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@excalidraw/excalidraw": "^0.18.1",
    "@sanity/client": "^8.15.1",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.22.0",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.8",
    "astro-portabletext": "^1.0.1",
    "easymde": "^2.21.0",
    "hls.js": "^1.7.4",
    "marked": "^18.2.0",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "sanity": "^6.22.0",
    "sanity-plugin-markdown": "^9.0.18",
    "sanity-plugin-rich-table": "^2.2.3",
    "simple-icons": "^16.37.0",
    "styled-components": "^6.6.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.1",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15"
  }
}
